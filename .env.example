# -----------------------------------------------------------------
# SLACK CONFIGURATION
# -----------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# -----------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/teampulse

# -----------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------
# AI CONFIGURATION
# -----------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
PULSE_AI_ENABLED=true

# -----------------------------------------------------------------
# DAILY DIGEST SCHEDULER
# -----------------------------------------------------------------
DIGEST_SCHEDULER_ENABLED=false
DAILY_DIGEST_CRON=0 0 9 * * 0-4
DAILY_DIGEST_TIMEZONE=Asia/Riyadh

# -----------------------------------------------------------------
# JIRA OAUTH INTEGRATION
# -----------------------------------------------------------------
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3000/api/auth/jira/callback
JIRA_AUTH_URL=https://auth.atlassian.com/authorize
JIRA_TOKEN_URL=https://auth.atlassian.com/oauth/token
JIRA_API_URL=https://api.atlassian.com
JIRA_SCOPES=read:jira-work write:jira-work read:jira-user offline_access
JIRA_TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------
# AI WORKSPACE UI (frontend — set in frontend/.env as VITE_*)
# -----------------------------------------------------------------
# Hide source chips under normal AI chat answers (default). Set true to debug RAG citations in chat.
# VITE_SHOW_AI_SOURCES=false

# -----------------------------------------------------------------
# SLACK DIGEST DELIVERY
# -----------------------------------------------------------------
SLACK_DIGEST_ENABLED=false
SLACK_DIGEST_CHANNEL_ID=
SEND_EMPTY_DIGEST=false

DAILY_COLLECTION_CRON=0 0 8 * * 0-4
DAILY_REMINDER_CRON=0 45 8 * * 0-4

SLACK_SOCKET_MODE_ENABLED=false