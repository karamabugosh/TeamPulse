# -----------------------------------------------------------------
# SLACK CONFIGURATION
# -----------------------------------------------------------------
# SLACK_BOT_TOKEN
# Starts with 'xoxb-'. Found in: OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# SLACK_SIGNING_SECRET
# Found in: Basic Information -> App Credentials -> Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret

# SLACK_APP_TOKEN
# Starts with 'xapp-'. Found in: Basic Information -> App-Level Tokens
# Required for Socket Mode. Must have connections:write scope.
SLACK_APP_TOKEN=xapp-your-app-token

# -----------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------
PORT=3000
