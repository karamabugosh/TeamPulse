# ================================================================
# PULSE / TEAMPULSE BACKEND ENVIRONMENT CONFIGURATION
# ================================================================
#
# Copy this file to .env for local development.
#
# IMPORTANT:
# - Never commit the real .env file.
# - Never place real Slack/OpenAI credentials in this example.
# - Rotate any credential that has previously been exposed.
#


# ----------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------

PORT=3000
NODE_ENV=development


# ----------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------
#
# PostgreSQL connection used by Prisma.
#
# Example:
# postgresql://username:password@localhost:5432/teampulse
#

DATABASE_URL=postgresql://username:password@localhost:5432/teampulse


# ----------------------------------------------------------------
# SLACK APPLICATION
# ----------------------------------------------------------------

# Slack bot OAuth token.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack signing secret.
SLACK_SIGNING_SECRET=your-signing-secret

# Slack app-level token used for Socket Mode.
SLACK_APP_TOKEN=xapp-your-app-token

# Set true when running Slack through Socket Mode.
SLACK_SOCKET_MODE_ENABLED=false


# ----------------------------------------------------------------
# OPENAI / AI ANALYSIS
# ----------------------------------------------------------------

OPENAI_API_KEY=your-openai-api-key

# Model used by the current Pulse AI layer.
OPENAI_MODEL=gpt-4o-mini

# Master switch for AI-powered analysis.
# When false, Pulse should use non-AI/rules-based fallbacks
# where supported.
PULSE_AI_ENABLED=true


# ----------------------------------------------------------------
# V2 CHECK-IN SCHEDULER
# ----------------------------------------------------------------
#
# Preferred V2 scheduler switch.
#
# When true:
# - enabled CheckIns are loaded from PostgreSQL
# - collectionCron jobs are registered
# - reportCron jobs are registered
# - the persistent reminder sweep is registered
#
# CheckIn timezone/cron values themselves live in PostgreSQL.
#

CHECKIN_SCHEDULER_ENABLED=false


# ----------------------------------------------------------------
# LEGACY / COMPATIBILITY SCHEDULER
# ----------------------------------------------------------------
#
# DIGEST_SCHEDULER_ENABLED remains supported as a compatibility
# fallback while V1 scheduler paths still exist.
#
# V2 should prefer CHECKIN_SCHEDULER_ENABLED.
#

DIGEST_SCHEDULER_ENABLED=false

# Legacy workspace-level automatic standup trigger.
STANDUP_SCHEDULER_ENABLED=false

# Legacy workspace-level reminder scheduler.
REMINDER_SCHEDULER_ENABLED=false


# ----------------------------------------------------------------
# LEGACY DEFAULT SCHEDULES
# ----------------------------------------------------------------
#
# These values support older team/workspace scheduling paths.
#
# V2 CheckIns use collectionCron, reportCron, timezone, and
# reminderMinutesAfter stored directly in PostgreSQL.
#

DAILY_COLLECTION_CRON=0 0 8 * * 0-4
DAILY_REMINDER_CRON=0 45 8 * * 0-4
DAILY_DIGEST_CRON=0 0 9 * * 0-4
DAILY_DIGEST_TIMEZONE=Asia/Riyadh


# ----------------------------------------------------------------
# V2 PERSISTENT REMINDERS
# ----------------------------------------------------------------
#
# Reminder due-times are stored on StandupRun in PostgreSQL.
#
# A background scheduler sweep checks for due reminders every
# minute.
#
# No setTimeout-based reminder state is required.
#

# No additional switch is required for the reminder sweep.
# It runs when CHECKIN_SCHEDULER_ENABLED=true.


# ----------------------------------------------------------------
# INBOUND EVENT IDEMPOTENCY / RECOVERY
# ----------------------------------------------------------------
#
# Slack inbound events are stored in PostgreSQL so retries do not
# cause duplicate processing.
#
# Events stuck in "processing" longer than this value are treated
# as abandoned and may be atomically reclaimed.
#
# Default in code: 5 minutes.
#

INBOUND_EVENT_PROCESSING_STALE_MINUTES=5


# ----------------------------------------------------------------
# SLACK REPORT / DIGEST DELIVERY
# ----------------------------------------------------------------
#
# Controls whether generated reports are actually posted to Slack.
#

SLACK_DIGEST_ENABLED=false

# Legacy/environment-fallback digest channel.
#
# V2 CheckIns should normally use reportChannelId stored in
# PostgreSQL instead.
SLACK_DIGEST_CHANNEL_ID=

# When false, Pulse will not post a report if a run has no
# completed responses.
SEND_EMPTY_DIGEST=false