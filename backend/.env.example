# =============================================================================
# TeamPulse backend — production environment template (Render + Neon)
# Copy to .env for local use. On Render, set these in the dashboard only.
# Never commit real secrets.
# Database guide: docs/deployment/neon-postgresql.md
# Deploy guide: docs/deployment/render-backend-deployment.md
# =============================================================================

# --- Runtime ---
NODE_ENV=production
# Render injects PORT; do not hardcode in production.
PORT=10000

# --- Database (required) — Neon PostgreSQL ONLY ---
# Direct endpoint (recommended for initial deploy + migrate deploy):
# postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Pooled endpoint (optional runtime tuning — see neon-postgresql.md):
# postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DO NOT use localhost, pulse_test, or teampulse in production.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Frontend / CORS (required in production) ---
FRONTEND_URL=https://your-frontend.example.com
# CORS_ORIGINS=https://your-frontend.example.com

# --- Slack (required for messaging / Socket Mode) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=xapp-...
SLACK_SOCKET_MODE_ENABLED=true
SLACK_DIGEST_CHANNEL_ID=C...
SLACK_DIGEST_ENABLED=true

# --- OpenAI / Pulse AI ---
PULSE_AI_ENABLED=true
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Schedulers / digests ---
DAILY_DIGEST_TIMEZONE=Asia/Riyadh
DAILY_COLLECTION_CRON=8 11 * * 1-5
DAILY_DIGEST_CRON=8 11 * * 1-5
CHECKIN_SCHEDULER_ENABLED=true
DIGEST_SCHEDULER_ENABLED=true

# --- Jira OAuth (required for Jira integration) ---
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=https://teampulse-backend.onrender.com/api/jira/oauth/callback
JIRA_AUTH_URL=https://auth.atlassian.com/authorize
JIRA_TOKEN_URL=https://auth.atlassian.com/oauth/token
JIRA_API_URL=https://api.atlassian.com
JIRA_SCOPES=read:jira-work write:jira-work read:jira-user offline_access

# --- Memory (optional) ---
MEMORY_V2_ASK_MODE=hybrid

# --- Dashboard login (required for securing the React frontend) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
