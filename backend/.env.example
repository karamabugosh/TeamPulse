# =============================================================================
# TeamPulse backend — production environment template
# Copy to .env for local use. On Render, set these as Environment Variables.
# Never commit real secrets.
# =============================================================================

# --- Runtime ---
NODE_ENV=production
# Render injects PORT automatically; override only for local production runs.
PORT=3000

# --- Database (required) ---
# PostgreSQL connection string (Render Postgres or external).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- Frontend / CORS (required in production) ---
# Primary SPA origin used for CORS and Jira OAuth return redirects.
FRONTEND_URL=https://your-frontend.example.com
# Optional comma-separated extra origins (e.g. preview deploys).
# CORS_ORIGINS=https://your-frontend.example.com,https://preview.example.com

# --- Slack (required for messaging / Socket Mode) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=xapp-...
SLACK_SOCKET_MODE_ENABLED=true
# Optional: default workspace team id for single-workspace installs
# SLACK_TEAM_ID=T...
SLACK_DIGEST_CHANNEL_ID=C...
SLACK_DIGEST_ENABLED=true

# --- OpenAI / Pulse AI ---
PULSE_AI_ENABLED=true
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# PULSE_AI_TRACE_MODE=full

# --- Schedulers / digests ---
DAILY_DIGEST_TIMEZONE=Asia/Riyadh
DAILY_COLLECTION_CRON=8 11 * * 1-5
DAILY_DIGEST_CRON=8 11 * * 1-5
CHECKIN_SCHEDULER_ENABLED=true
DIGEST_SCHEDULER_ENABLED=true
# STANDUP_SCHEDULER_ENABLED=true
# REMINDER_SCHEDULER_ENABLED=true
# SEND_EMPTY_DIGEST=false

# --- Jira OAuth (required for Jira integration) ---
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=https://your-backend.onrender.com/api/jira/oauth/callback
JIRA_AUTH_URL=https://auth.atlassian.com/authorize
JIRA_TOKEN_URL=https://auth.atlassian.com/oauth/token
JIRA_API_URL=https://api.atlassian.com
JIRA_SCOPES=read:jira-work write:jira-work read:jira-user offline_access
# Optional; falls back to JIRA_CLIENT_SECRET if unset
# JIRA_TOKEN_ENCRYPTION_KEY=

# --- Memory (optional tuning) ---
MEMORY_V2_ASK_MODE=hybrid
# MEMORY_WORKER_ENABLED=true
# MEMORY_WORKER_BATCH_SIZE=8
# MEMORY_V2_SHADOW_ENABLED=false
# MEMORY_V2_VECTOR_JSON_FALLBACK=true
