generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id                 String   @id @default(uuid())
  slackWorkspaceId   String   @unique
  slackWorkspaceName String
  botToken           String
  installedAt        DateTime @default(now())

  users User[]
  teams Team[]
}

model User {
  id               String   @id @default(uuid())
  workspaceId      String
  slackUserId      String   @unique
  slackDisplayName String
  email            String?
  timezone         String?
  createdAt        DateTime @default(now())

  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  teamMembers       TeamMember[]
  answers           Answer[]
  submissions       StandupSubmission[]
  conversationState ConversationState?
}

model Team {
  id               String   @id @default(uuid())
  workspaceId      String
  name             String
  slackChannelId   String?
  scheduleCron     String?
  timezone         String?
  schedulerEnabled Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  teamMembers TeamMember[]
  standupRuns StandupRun[]
  aiDigests   AiDigest[]
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     String   @default("member")
  optedOut Boolean  @default(false)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Question {
  id        String   @id @default(uuid())
  question  String
  order     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers Answer[]
}

model StandupRun {
  id           String    @id @default(uuid())
  teamId       String
  scheduledFor DateTime
  status       String    @default("collecting")
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  team        Team                @relation(fields: [teamId], references: [id])
  submissions StandupSubmission[]
  aiDigests   AiDigest[]

  @@unique([teamId, scheduledFor])
  @@index([teamId])
  @@index([status])
  @@index([scheduledFor])
}

model StandupSubmission {
  id          String    @id @default(uuid())
  runId       String
  userId      String
  status      String    @default("pending")
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  run               StandupRun         @relation(fields: [runId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  answers           Answer[]
  conversationState ConversationState?

  @@unique([runId, userId])
  @@index([runId])
  @@index([userId])
  @@index([status])
}

model Answer {
  id           String             @id @default(uuid())
  userId       String
  questionId   String
  submissionId String?
  text         String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user       User               @relation(fields: [userId], references: [id])
  question   Question           @relation(fields: [questionId], references: [id])
  submission StandupSubmission? @relation(fields: [submissionId], references: [id])

  @@index([userId])
  @@index([questionId])
  @@index([submissionId])
}

model ConversationState {
  id                String    @id @default(uuid())
  userId            String    @unique
  submissionId      String?   @unique
  currentQuestionId String?
  isCompleted       Boolean   @default(false)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  user       User               @relation(fields: [userId], references: [id])
  submission StandupSubmission? @relation(fields: [submissionId], references: [id])
}

model AiDigest {
  id          String   @id @default(uuid())
  teamId      String
  runId       String
  generatedAt DateTime @default(now())
  source      String
  summary     String
  blockers    Json
  themes      Json
  createdAt   DateTime @default(now())

  team Team       @relation(fields: [teamId], references: [id])
  run  StandupRun @relation(fields: [runId], references: [id])

  @@index([teamId])
  @@index([runId])
}