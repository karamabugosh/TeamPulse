generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  FREE_TEXT
  NUMERICAL
  YES_NO
  YES_NO_MAYBE
  MULTIPLE_CHOICE
  SCALE_1_5
  ISSUE_REF
}

enum JiraConnectionStatus {
  PENDING
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum JiraIntegrationHealth {
  NOT_CONFIGURED
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

model Workspace {
  id                 String   @id @default(uuid())
  slackWorkspaceId   String   @unique
  slackWorkspaceName String
  botToken           String
  installedAt        DateTime @default(now())

  users            User[]
  teams            Team[]
  inboundEvents    InboundEvent[]
  jiraIntegrations JiraIntegration[]
  jiraOAuthStates  JiraOAuthState[]
}

model User {
  id               String   @id @default(uuid())
  workspaceId      String
  slackUserId      String   @unique
  slackDisplayName String
  email            String?
  timezone         String?
  createdAt        DateTime @default(now())

  focusedSubmissionId String?            @unique
  workspace           Workspace          @relation(fields: [workspaceId], references: [id])
  teamMembers         TeamMember[]
  answers             Answer[]
  submissions         StandupSubmission[]
  conversationStates  ConversationState[]
  threadUpdates       StandupThreadUpdate[]
  jiraConnections     JiraUserConnection[]
  jiraOAuthStates     JiraOAuthState[]
  focusedSubmission   StandupSubmission? @relation("FocusedSubmission", fields: [focusedSubmissionId], references: [id], onDelete: SetNull)
}

model Team {
  id               String   @id @default(uuid())
  workspaceId      String
  name             String
  slackChannelId   String?
  scheduleCron     String?
  timezone         String?
  schedulerEnabled Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  teamMembers TeamMember[]
  standupRuns StandupRun[]
  aiDigests   AiDigest[]
  checkIns    CheckIn[]
  jiraConfig  TeamJiraConfig?

  @@index([workspaceId])
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     String   @default("member")
  optedOut Boolean  @default(false)
  joinedAt DateTime @default(now())

  team                Team                 @relation(fields: [teamId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  checkInParticipants CheckInParticipant[]

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model CheckIn {
  id           String  @id @default(uuid())
  teamId       String
  name         String
  description  String?
  introMessage String?
  outroMessage String?
  enabled      Boolean @default(true)

  timezone         String
  collectionCron   String
  updatesChannelId String?

  reminderEnabled           Boolean @default(true)
  reminderMinutesAfter      Int     @default(30)
  reminderRecurringEnabled  Boolean @default(false)
  reminderIntervalMinutes   Int?
  reminderOnlyNonResponders Boolean @default(true)
  reminderOnSlackActive     Boolean @default(false)

  reportCron           String?
  reportTriggerMode    String @default("scheduled")
  reportTimeoutMinutes Int?

  publishStatus   String  @default("published")
  scheduleEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team         Team                 @relation(fields: [teamId], references: [id])
  questions    Question[]
  participants CheckInParticipant[]
  runs         StandupRun[]

  @@index([teamId])
  @@index([enabled])
}

model CheckInParticipant {
  id           String   @id @default(uuid())
  checkInId    String
  teamMemberId String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  checkIn    CheckIn    @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([checkInId, teamMemberId])
  @@index([checkInId])
  @@index([teamMemberId])
}

model Question {
  id        String  @id @default(uuid())
  checkInId String?
  question  String
  order     Int

  type       QuestionType @default(FREE_TEXT)
  options    Json?
  isRequired Boolean      @default(true)
  isActive   Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIn            CheckIn?            @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  answers            Answer[]
  conversationStates ConversationState[]
  jiraConfig         JiraQuestionConfig?

  @@index([checkInId])
  @@index([isActive])
}

model StandupRun {
  id            String    @id @default(uuid())
  teamId        String
  checkInId     String?
  scheduledFor  DateTime
  status        String    @default("collecting")
  triggerSource String    @default("scheduler")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  reminderDueAt  DateTime?
  reminderSentAt DateTime?
  reminderCount  Int       @default(0)
  lastReminderAt DateTime?

  slackChannelId     String?
  slackThreadTs      String?
  slackRootMessageTs String?
  slackThreadUrl     String?
  threadReplyCount   Int     @default(0)

  reportDueAt       DateTime?
  reportGeneratedAt DateTime?
  reportStatus      String    @default("waiting_for_responses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team          Team                  @relation(fields: [teamId], references: [id])
  checkIn       CheckIn?              @relation(fields: [checkInId], references: [id])
  submissions   StandupSubmission[]
  aiDigest      AiDigest?
  threadUpdates StandupThreadUpdate[]

  @@unique([checkInId, scheduledFor])
  @@index([teamId])
  @@index([checkInId])
  @@index([status])
  @@index([scheduledFor])
  @@index([reminderDueAt])
  @@index([reminderSentAt])
  @@index([reportDueAt])
  @@index([reportStatus])
}

model StandupSubmission {
  id               String    @id @default(uuid())
  runId            String
  userId           String
  status            String    @default("pending")
  startedAt        DateTime?
  completedAt      DateTime?
  slackDmChannelId String?
  slackDmThreadTs  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  run               StandupRun            @relation(fields: [runId], references: [id])
  user              User                  @relation(fields: [userId], references: [id])
  answers           Answer[]
  conversationState ConversationState?
  threadUpdates     StandupThreadUpdate[]
  focusedByUser     User?                 @relation("FocusedSubmission")

  @@unique([runId, userId])
  @@index([runId])
  @@index([userId])
  @@index([status])
  @@index([slackDmThreadTs])
}

model Answer {
  id              String   @id @default(uuid())
  userId          String
  questionId      String
  submissionId    String?
  text            String
  structuredValue Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id])
  question   Question           @relation(fields: [questionId], references: [id])
  submission StandupSubmission? @relation(fields: [submissionId], references: [id])

  @@unique([submissionId, questionId])
  @@index([userId])
  @@index([questionId])
  @@index([submissionId])
}

model ConversationState {
  id                String    @id @default(uuid())
  userId            String
  submissionId      String    @unique
  currentQuestionId String?
  isCompleted       Boolean   @default(false)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  submission      StandupSubmission @relation(fields: [submissionId], references: [id])
  currentQuestion Question?         @relation(fields: [currentQuestionId], references: [id])

  @@index([userId])
  @@index([currentQuestionId])
}

model AiDigest {
  id                String   @id @default(uuid())
  teamId            String
  runId             String   @unique
  generatedAt       DateTime @default(now())
  source            String
  summary           String
  blockers          Json
  themes            Json
  reportSections    Json?
  slackReportText   String?
  nonResponderNames Json?
  slackReportBlocks Json?
  generationError   String?
  createdAt         DateTime @default(now())

  team Team       @relation(fields: [teamId], references: [id])
  run  StandupRun @relation(fields: [runId], references: [id])

  @@index([teamId])
}

model StandupThreadUpdate {
  id             String   @id @default(uuid())
  runId          String
  submissionId   String?
  userId         String
  type           String
  slackMessageTs String?
  content        String
  createdAt      DateTime @default(now())

  run        StandupRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  submission StandupSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  user       User               @relation(fields: [userId], references: [id])

  @@index([runId])
  @@index([submissionId])
  @@index([userId])
}

model InboundEvent {
  id              String    @id @default(uuid())
  workspaceId     String
  provider        String    @default("slack")
  idempotencyKey  String    @unique
  externalEventId String?
  eventType       String
  payloadHash     String?
  status          String    @default("received")
  errorMessage    String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([externalEventId])
  @@index([status])
  @@index([receivedAt])
}

model JiraIntegration {
  id          String @id @default(uuid())
  workspaceId String

  cloudId  String
  siteUrl  String
  siteName String?

  enabled   Boolean @default(true)
  isDefault Boolean @default(false)

  defaultProjectKey  String?
  allowedProjectKeys String[] @default([])

  cacheTtlMinutes Int @default(15)

  health               JiraIntegrationHealth @default(NOT_CONFIGURED)
  lastHealthCheckAt     DateTime?
  lastSuccessfulSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teamConfigs     TeamJiraConfig[]
  userConnections JiraUserConnection[]

  @@unique([workspaceId, cloudId])
  @@index([workspaceId])
  @@index([workspaceId, enabled])
  @@index([workspaceId, isDefault])
  @@index([health])
}

model TeamJiraConfig {
  id                String  @id @default(uuid())
  teamId            String  @unique
  jiraIntegrationId String?

  enabled                Boolean @default(false)
  issuePickerEnabled     Boolean @default(true)
  activityPrefillEnabled Boolean @default(false)

  commentProposalEnabled     Boolean @default(true)
  transitionProposalEnabled  Boolean @default(true)
  blockerProposalEnabled     Boolean @default(true)
  issueLinkProposalEnabled   Boolean @default(true)
  createIssueProposalEnabled Boolean @default(false)

  defaultProjectKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  jiraIntegration JiraIntegration? @relation(fields: [jiraIntegrationId], references: [id], onDelete: SetNull)

  @@index([jiraIntegrationId])
  @@index([enabled])
}

model JiraQuestionConfig {
  id         String @id @default(uuid())
  questionId String @unique

  allowMultiple Boolean @default(false)
  maxSelections Int     @default(1)

  allowedProjectKeys String[] @default([])

  plaintextFallbackEnabled Boolean @default(true)
  actionProposalEnabled    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([actionProposalEnabled])
}

model JiraUserConnection {
  id                String @id @default(uuid())
  userId            String
  jiraIntegrationId String

  jiraAccountId   String
  jiraDisplayName String?
  jiraEmail       String?

  accessTokenCiphertext  String
  refreshTokenCiphertext String
  grantedScopes          String[] @default([])
  accessTokenExpiresAt   DateTime

  status          JiraConnectionStatus @default(CONNECTED)
  lastValidatedAt DateTime?
  lastUsedAt      DateTime?
  disconnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jiraIntegration JiraIntegration @relation(fields: [jiraIntegrationId], references: [id], onDelete: Cascade)

  @@unique([userId, jiraIntegrationId])
  @@unique([jiraIntegrationId, jiraAccountId])
  @@index([jiraIntegrationId, status])
  @@index([status])
}

model JiraOAuthState {
  id          String @id @default(uuid())
  workspaceId String
  userId      String
  stateHash   String @unique

  expiresAt DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([consumedAt])
}