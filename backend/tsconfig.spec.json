{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node", "jest"],
    "noEmit": true,
    "isolatedModules": true
  },
    "include": [
    "src/**/*",
    "test/**/*",
    "integration/**/*",
    "jest.config.js"
  ],
  "exclude": ["node_modules", "dist"]
}
